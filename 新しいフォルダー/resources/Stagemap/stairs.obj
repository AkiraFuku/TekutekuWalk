# Wavefront OBJ: stairs.obj (4-Step Stairs)
# Dimensions: X [-1.0, 1.0], Y [0.0, 1.0], Z [-2.0, 2.0]
# 4 steps: each riser = 0.25m, each tread = 1.0m
o Stairs

# Vertices
# Step 1: tread Y=0.25, Z [1.0, 2.0]
v -1.0 0.00  2.0
v  1.0 0.00  2.0
v -1.0 0.25  2.0
v  1.0 0.25  2.0
v -1.0 0.25  1.0
v  1.0 0.25  1.0

# Step 2: tread Y=0.50, Z [0.0, 1.0]
v -1.0 0.50  1.0
v  1.0 0.50  1.0
v -1.0 0.50  0.0
v  1.0 0.50  0.0

# Step 3: tread Y=0.75, Z [-1.0, 0.0]
v -1.0 0.75  0.0
v  1.0 0.75  0.0
v -1.0 0.75 -1.0
v  1.0 0.75 -1.0

# Step 4: tread Y=1.00, Z [-2.0, -1.0]
v -1.0 1.00 -1.0
v  1.0 1.00 -1.0
v -1.0 1.00 -2.0
v  1.0 1.00 -2.0

# Bottom back vertices
v -1.0 0.00 -2.0
v  1.0 0.00 -2.0

# Texture coordinates
vt 0.0 0.0
vt 1.0 0.0
vt 1.0 1.0
vt 0.0 1.0

# Normals
vn  0.0  1.0  0.0  # 1: Up (tread)
vn  0.0  0.0  1.0  # 2: Forward (riser)
vn  0.0 -1.0  0.0  # 3: Down (bottom)
vn  0.0  0.0 -1.0  # 4: Back
vn -1.0  0.0  0.0  # 5: Left
vn  1.0  0.0  0.0  # 6: Right

# Riser 1 (Z=2.0, Y: 0.00 -> 0.25)
f 1/1/2 2/2/2 4/3/2
f 1/1/2 4/3/2 3/4/2

# Tread 1 (Y=0.25, Z: 2.0 -> 1.0)
f 3/1/1 4/2/1 6/3/1
f 3/1/1 6/3/1 5/4/1

# Riser 2 (Z=1.0, Y: 0.25 -> 0.50)
f 5/1/2 6/2/2 8/3/2
f 5/1/2 8/3/2 7/4/2

# Tread 2 (Y=0.50, Z: 1.0 -> 0.0)
f 7/1/1 8/2/1 10/3/1
f 7/1/1 10/3/1 9/4/1

# Riser 3 (Z=0.0, Y: 0.50 -> 0.75)
f 9/1/2 10/2/2 12/3/2
f 9/1/2 12/3/2 11/4/2

# Tread 3 (Y=0.75, Z: 0.0 -> -1.0)
f 11/1/1 12/2/1 14/3/1
f 11/1/1 14/3/1 13/4/1

# Riser 4 (Z=-1.0, Y: 0.75 -> 1.00)
f 13/1/2 14/2/2 16/3/2
f 13/1/2 16/3/2 15/4/2

# Tread 4 (Y=1.00, Z: -1.0 -> -2.0)
f 15/1/1 16/2/1 18/3/1
f 15/1/1 18/3/1 17/4/1

# Back face (Z=-2.0, Y: 0.0 -> 1.0)
f 20/1/4 19/2/4 17/3/4
f 20/1/4 17/3/4 18/4/4

# Bottom face (Y=0.0, Z: -2.0 -> 2.0)
f 19/1/3 20/2/3 2/3/3
f 19/1/3 2/3/3 1/4/3
